class_name ZoneRoom
extends Resource
## Комната зоны на карте мира (T-33, AC-04.2).
##
## Данные карты живут в ZoneData (`map_rooms`), а не в UI: одна комната —
## одна клетка сетки миникарты 8x6 px (DESIGN §4.3). `world_rect` привязывает
## мировые координаты зоны (точки входа/выхода, костры, позицию игрока) к
## клетке карты, поэтому полная карта и миникарта показывают одно и то же.

## Стабильный id комнаты в пределах зоны.
@export var id: StringName = &"room"
## Клетка на сетке карты (12x9 для миникарты 96x54).
@export var grid_position: Vector2i = Vector2i.ZERO
## Прямоугольник комнаты в мировых координатах зоны (480x270 — экран зоны).
@export var world_rect: Rect2 = Rect2(0, 0, 480, 270)
