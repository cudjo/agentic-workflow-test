{
  "name": "notes-service-server",
  "version": "0.0.0",
  "private": true,
  "description": "Notes Service backend (Fastify + SQLite via node:sqlite)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build:web": "npm --prefix ../web run build",
    "serve": "npm run build:web && npm start",
    "smoke": "node scripts/e2e-smoke.mjs",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:down": "tsx src/db/migrate.ts --down",
    "migrate:status": "tsx src/db/migrate.ts --status",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^10.1.6",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.6.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
