# Notes Service — пример конфигурации окружения (PLAN §4.7, NFR-8).
#
# Скопируйте в `.env` и заполните секретами. Файл `.env` в `.gitignore` и НЕ коммитится:
# реальных секретов в репозитории нет (этот пример — только имена переменных и безопасные
# значения по умолчанию для локального запуска).
#
# Запуск прод-режима (однопроцессный деплой: Fastify отдаёт API + собранный SPA):
#   npm --prefix web run build     # собрать web/dist
#   cd server && npm start         # http://localhost:3000

# --- Режим ---
# production | development | test. В production обязателен SESSION_SECRET.
NODE_ENV=production

# --- Сеть ---
# Адрес прослушивания. 127.0.0.1 — только локально; 0.0.0.0 — доступ извне (контейнер).
HOST=127.0.0.1
PORT=3000

# --- Хранилище ---
# Путь к файлу SQLite (по умолчанию server/data/app.db). Каталог создаётся автоматически.
DATABASE_PATH=server/data/app.db

# --- Раздача SPA (T-12) ---
# Каталог собранного фронтенда. По умолчанию web/dist относительно корня репозитория.
STATIC_DIR=web/dist

# --- Безопасность ---
# Секрет подписи сессий. ОБЯЗАТЕЛЕН в production. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Отправлять cookie только по HTTPS. true — за TLS/в проде, false — локальный HTTP (dev).
COOKIE_SECURE=false

# Разрешённый origin для CORS (dev-фронтенд Vite). В однопроцессном проде SPA и API
# одного происхождения — можно оставить значение по умолчанию.
CORS_ORIGIN=http://localhost:5173

# --- Логи ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
