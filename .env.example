# Notes Service — пример конфигурации окружения (PLAN §4.7, NFR-8).
#
# Скопируйте в `.env` и при необходимости переопределите значения. Файл `.env` в `.gitignore`
# и НЕ коммитится: реальных секретов в репозитории нет (этот пример — только имена переменных
# и безопасные значения по умолчанию).
#
# Запуск прод-режима (однопроцессный деплой: Fastify отдаёт API + собранный SPA):
#   npm --prefix web run build     # собрать web/dist
#   cd server && npm start         # http://localhost:3000
# Локальный запуск прод-сборки идёт по HTTP — задайте COOKIE_SECURE=false (см. ниже), иначе
# браузер не отправит cookie сессии. За TLS (реальный прод) оставьте COOKIE_SECURE=true.

# --- Режим ---
# production | development | test. SESSION_SECRET не требуется: сессии — opaque-токен
# (randomBytes(32)), в БД только его SHA-256 (подпись не нужна), CSRF — сверка csrf_token
# через timingSafeEqual.
NODE_ENV=production

# --- Сеть ---
# Адрес прослушивания. 127.0.0.1 — только локально; 0.0.0.0 — доступ извне (контейнер).
HOST=127.0.0.1
PORT=3000

# --- Хранилище ---
# Путь к файлу SQLite (по умолчанию server/data/app.db). Каталог создаётся автоматически.
DATABASE_PATH=server/data/app.db

# --- Раздача SPA (T-12) ---
# Каталог собранного фронтенда. По умолчанию web/dist относительно корня репозитория.
STATIC_DIR=web/dist

# --- Безопасность ---
# Отправлять cookie только по HTTPS (NFR-10). Безопасный дефолт: true в production, false в dev/test.
# Прод за TLS — true. Локальный запуск прод-сборки по http://localhost:3000 — явно false.
COOKIE_SECURE=true

# Необязательный секрет окружения. Для целостности сессии НЕ используется (см. NODE_ENV выше):
# можно оставить пустым в любом режиме. Если задан — переносится в конфиг как есть.
SESSION_SECRET=

# Разрешённый origin для CORS (dev-фронтенд Vite). В однопроцессном проде SPA и API
# одного происхождения — можно оставить значение по умолчанию.
CORS_ORIGIN=http://localhost:5173

# --- Логи ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
